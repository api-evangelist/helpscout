{
  "opencollection": "1.0.0",
  "info": {
    "name": "Help Scout Mailbox Conversations Teams API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.helpscout.net/v2/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.helpscout.net/v2/teams"
          },
          "docs": "List teams"
        }
      ]
    }
  ],
  "bundled": true
}