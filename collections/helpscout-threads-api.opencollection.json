{
  "opencollection": "1.0.0",
  "info": {
    "name": "Help Scout Mailbox Conversations Threads API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.helpscout.net/v2/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Threads",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create thread",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.helpscout.net/v2/conversations/:id/threads",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create thread"
        }
      ]
    }
  ],
  "bundled": true
}